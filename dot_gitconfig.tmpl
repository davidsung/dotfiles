[user]
	name = David Sung
	email = {{ .email }}

# delta: syntax-highlighted diffs (only used when output is a terminal)
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3

# Push to GitHub over SSH (1Password SSH agent); fetch/clone stay on HTTPS
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
