# Homebrew (Apple Silicon or Intel)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv zsh)"
fi

# User-local binaries (chezmoi, Claude Code native installer, etc.)
export PATH="$HOME/.local/bin:$PATH"

# mise shims: tools (node, etc.) for non-interactive use (editors, scripts, services)
command -v mise >/dev/null && eval "$(mise activate zsh --shims)"

# 1Password CLI: use the app integration (Touch ID) on Macs with the 1Password app.
# Without this, `op` may report "not signed in" because macOS blocks it from reading the
# app's settings file. Not forced elsewhere (e.g. Linux with manual or service-account sign-in).
[[ $OSTYPE == darwin* && -d /Applications/1Password.app ]] && export OP_BIOMETRIC_UNLOCK_ENABLED=true
