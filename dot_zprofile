# Homebrew (Apple Silicon or Intel)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv zsh)"
fi

# User-local binaries (chezmoi, Claude Code native installer, etc.)
export PATH="$HOME/.local/bin:$PATH"

# mise shims: tools (node, etc.) for non-interactive use (editors, scripts, services)
command -v mise >/dev/null && eval "$(mise activate zsh --shims)"

# API keys: `secrets` command; export the keys marked for export (from Keychain, silent)
if [[ -r ~/.config/zsh/secrets.zsh ]]; then
  source ~/.config/zsh/secrets.zsh
  secrets export
fi

# Private settings (dotfiles-private repo, cloned by chezmoi once 1Password's SSH agent runs)
[[ -r ~/.config/dotfiles-private/zsh/private.zsh ]] && source ~/.config/dotfiles-private/zsh/private.zsh
